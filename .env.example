# ---------------------------------------------------------------------------
# Environment configuration — copy this file to `.env` and fill in real values.
#     cp .env.example .env
# The real .env file is git-ignored and must NEVER be committed.
# ---------------------------------------------------------------------------

# Runtime environment: "development" | "production"
NODE_ENV=development

# Port the HTTP server binds to (defaults to 3000 if unset).
PORT=3000

# PostgreSQL connection string used by Prisma.
#   Local dev (server running on host):      host = localhost
#   Docker Compose (server in a container):  host = postgres  (the compose service name)
DATABASE_URL="postgresql://sartho:sartho@localhost:5432/sartho?schema=public"

# JWT signing secrets. Use long, random, DISTINCT values in every environment.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Allowed CORS origin (browser clients such as Flutter Web).
# Native/desktop clients are not subject to CORS, but this value is still required.
FRONTEND_URL="http://localhost:8080"

# ---------------------------------------------------------------------------
# NOT CURRENTLY USED
# The rate-limiter (throttler) runs with in-memory storage today. Redis-backed
# distributed rate limiting is a future enhancement; no REDIS_URL is required
# to run the application.
# ---------------------------------------------------------------------------
