# Dependencies (MUST be reinstalled inside the Linux image — argon2 and the
# Prisma query engine are native/platform-specific and Windows/host copies
# will not run in the container).
node_modules
npm-debug.log*

# Build output (regenerated by `nest build` inside the image)
dist

# Environment / secrets — never bake real secrets into an image layer
.env
.env.local
.env.*.local
.env.test

# Version control & CI
.git
.gitignore
.github

# Docker files themselves
Dockerfile
docker-compose*.yml
.dockerignore

# Editor / OS noise
.vscode
.idea
*.swp
.DS_Store

# Docs & logs
README.md
logs
*.log
coverage
*.tsbuildinfo
